rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// AVR LOGISTIC DASHBOARD — Firestore Security Rules
// Project: avr-logistic-dashboard
//
// Modello di autorizzazione:
//   • superadmin → amministrazione@avrlogisticarl.com (accesso completo)
//   • staff      → michela@, alessandra@ (accesso completo operativo,
//                  no costi mensili, no log accessi)
//   • driver     → qualsiasi altro utente autenticato (app driver):
//                  accede solo ai propri record (filtrati su driverEmail)
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email != null
             ? request.auth.token.email.lower()
             : '';
    }

    function isSuperAdmin() {
      return isSignedIn() && userEmail() == 'amministrazione@avrlogisticarl.com';
    }

    function isStaff() {
      return isSignedIn()
             && (userEmail() == 'michela@avrlogisticarl.com'
                 || userEmail() == 'alessandra@avrlogisticarl.com');
    }

    function isAdminOrStaff() {
      return isSuperAdmin() || isStaff();
    }

    function isDriver() {
      return isSignedIn() && !isAdminOrStaff();
    }

    // Nota: confronto case-sensitive. I client scrivono driverEmail
    // sempre in lowercase (vedi commit 8f702a6). Rimuovere .lower() sul
    // lato resource.data è necessario perché Firestore rifiuta le query
    // list se il filtro non combacia staticamente con la rule.
    function isOwnByEmail() {
      return resource.data.driverEmail is string
             && resource.data.driverEmail == userEmail();
    }

    // ═══════════════════════════════════════════════════════════
    // OPERATIVITÀ AVR — admin + staff R/W
    // ═══════════════════════════════════════════════════════════
    match /consegne/{doc} {
      allow read: if isGestionale();
      allow write: if isAdminOrStaff();
    }

    match /filiali/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdminOrStaff();
    }

    // ═══════════════════════════════════════════════════════════
    // DRIVER ANAGRAFICA — admin/staff full; driver legge solo proprio
    // ═══════════════════════════════════════════════════════════
    match /driverAnagrafica/{doc} {
      allow read: if isGestionale()
                     || (isDriver()
                         && resource.data.email is string
                         && resource.data.email == userEmail());
      allow create, delete: if isAdminOrStaff();
      allow update: if isAdminOrStaff()
                       || (isDriver()
                           && resource.data.email == userEmail()
                           && request.resource.data.email == resource.data.email
                           && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['codiceFiscale','numeroPatente','scadenzaPatente',
                                        'telefono','dataNascita','indirizzo',
                                        'profiloCompletatoIl']));
    }

    // ═══════════════════════════════════════════════════════════
    // REPORT DRIVER — admin/staff full; driver crea + legge/elimina suoi
    // ═══════════════════════════════════════════════════════════
    match /reportDriver/{doc} {
      allow read: if isGestionale() || (isDriver() && isOwnByEmail());
      // Validazioni anti-abuso: da questi dati dipendono classifica e premi.
      // numConsegne 1–10 (come il limite dell'app), durataMin plausibile se
      // presente (report vecchi non ce l'hanno), mese nel formato YYYY-MM.
      allow create: if isSignedIn()
                       && request.resource.data.driverEmail is string
                       && request.resource.data.driverEmail.lower() == userEmail()
                       && request.resource.data.numConsegne is int
                       && request.resource.data.numConsegne >= 1
                       && request.resource.data.numConsegne <= 10
                       && request.resource.data.mese is string
                       && request.resource.data.mese.matches('[0-9]{4}-[0-9]{2}')
                       && (!('durataMin' in request.resource.data)
                           || (request.resource.data.durataMin is number
                               && request.resource.data.durataMin > 0
                               && request.resource.data.durataMin <= 720));
      allow update: if isAdminOrStaff();
      allow delete: if isAdminOrStaff() || (isDriver() && isOwnByEmail());
    }

    // ═══════════════════════════════════════════════════════════
    // RITORNI — admin/staff full; driver crea + legge/elimina suoi
    // ═══════════════════════════════════════════════════════════
    match /ritorni/{doc} {
      allow read: if isGestionale() || (isDriver() && isOwnByEmail());
      allow create: if isSignedIn()
                       && request.resource.data.driverEmail is string
                       && request.resource.data.driverEmail.lower() == userEmail();
      allow update: if isAdminOrStaff();
      allow delete: if isAdminOrStaff() || (isDriver() && isOwnByEmail());
    }

    // ═══════════════════════════════════════════════════════════
    // SEGNALAZIONI — admin/staff full; driver crea + legge sue
    // ═══════════════════════════════════════════════════════════
    match /segnalazioni/{doc} {
      allow read: if isGestionale() || (isDriver() && isOwnByEmail());
      allow create: if isSignedIn()
                       && request.resource.data.driverEmail is string
                       && request.resource.data.driverEmail.lower() == userEmail();
      allow update: if isAdminOrStaff();
      allow delete: if isAdminOrStaff();
    }

    // ═══════════════════════════════════════════════════════════
    // TURNI DRIVER — driver crea all'ingresso; admin/staff legge
    // ═══════════════════════════════════════════════════════════
    match /turniDriver/{doc} {
      allow create: if isSignedIn()
                       && request.resource.data.email is string
                       && request.resource.data.email == userEmail();
      allow read: if isAdminOrStaff()
                     || (isDriver()
                         && resource.data.email is string
                         && resource.data.email == userEmail());
      allow update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // DANNI — admin/staff full; driver legge solo suoi
    // ═══════════════════════════════════════════════════════════
    match /danni/{doc} {
      allow read: if isGestionale() || (isDriver() && isOwnByEmail());
      allow write: if isAdminOrStaff();
    }

    // ═══════════════════════════════════════════════════════════
    // COSTI MENSILI — solo superadmin (dati sensibili)
    // ═══════════════════════════════════════════════════════════
    match /costiMensili/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // LOG ACCESSI — tutti scrivono (auto-log), solo superadmin legge
    // ═══════════════════════════════════════════════════════════
    match /accessLog/{doc} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /driverAccessLog/{doc} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // LEADERBOARD — aggregato precalcolato da Cloud Function scheduled
    // Versione anonima letta da tutti i driver autenticati.
    // Scritture solo da admin SDK (CF bypassa le rules).
    // ═══════════════════════════════════════════════════════════
    match /leaderboard/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Versione completa con nome reale del driver — solo admin/staff.
    // Usata dalla dashboard per decidere premi/riconoscimenti.
    match /leaderboardFull/{doc} {
      allow read: if isAdminOrStaff();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // SYNC GOOGLE SHEETS — stato/log scritti dalla Cloud Function
    // (admin SDK bypassa le rules); config fogli gestita da superadmin
    // ═══════════════════════════════════════════════════════════
    match /syncStatus/{doc} {
      allow read: if isAdminOrStaff();
      allow write: if false;
    }

    match /syncLog/{doc} {
      allow read: if isAdminOrStaff();
      allow write: if false;
    }

    match /driveSheets/{doc} {
      allow read: if isAdminOrStaff();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // UTENTI — anagrafica utenti gestionale (amministratori, HR,
    // responsabili). Solo il superadmin hardcoded può scrivere qui.
    // Ogni utente può leggere il PROPRIO doc (per risolvere ruolo lato client).
    // Le altre rules potranno leggere utenti/{email}.mansione per gate futuri.
    // ═══════════════════════════════════════════════════════════
    match /utenti/{email} {
      allow read: if isSuperAdmin()
                     || (isSignedIn() && email == userEmail());
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // PUNTI TIMBRATURA — 5 sedi provinciali (CT/SR/ME/PA/EN) con NFC.
    // Lettura consentita a tutti gli utenti autenticati: il driver deve
    // sapere lat/lng del proprio punto per validare pre-timbratura.
    // Scrittura solo admin/HR: superadmin, amministratore, risorse_umane.
    // ═══════════════════════════════════════════════════════════
    function isAmministratore() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/utenti/$(userEmail()))
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.mansione == 'amministratore'
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.attivo != false;
    }
    function isRisorseUmane() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/utenti/$(userEmail()))
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.mansione == 'risorse_umane'
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.attivo != false;
    }
    function canManageTimbrature() {
      return isSuperAdmin() || isAmministratore() || isRisorseUmane();
    }
    function isResponsabile() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/utenti/$(userEmail()))
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.mansione == 'responsabile'
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.attivo != false;
    }
    // Tutti gli utenti del gestionale (superadmin/staff hardcoded +
    // amministratori, HR e responsabili dalla collection utenti):
    // vedono produttività, danni, ritorni, segnalazioni, consegne.
    function isGestionale() {
      return isAdminOrStaff() || isAmministratore() || isRisorseUmane() || isResponsabile();
    }

    match /puntiTimbratura/{provincia} {
      allow read: if isSignedIn();
      allow write: if canManageTimbrature();
    }

    // Token QR in chiaro per la stampa — SOLO gestori timbrature.
    // Nei doc puntiTimbratura è salvato solo l'hash SHA-256: i driver
    // verificano il QR scansionato senza poter leggere il token dal DB.
    match /qrTokens/{provincia} {
      allow read, write: if canManageTimbrature();
    }

    // ═══════════════════════════════════════════════════════════
    // TIMBRATURE — schema unificato per terminali ZKTeco (bridge,
    // admin SDK bypassa le rules) e app QR+geofence (create driver).
    // Nessuna modifica/cancellazione dal client: audit trail.
    // ═══════════════════════════════════════════════════════════
    match /timbrature/{doc} {
      allow read: if isAdminOrStaff()
                     || canManageTimbrature()
                     || (isSignedIn() && resource.data.driverId == userEmail());
      allow create: if isSignedIn()
                       && request.resource.data.driverId is string
                       && request.resource.data.driverId == userEmail()
                       && request.resource.data.fonte == 'app'
                       && (request.resource.data.metodo == 'app-qr-geo' || request.resource.data.metodo == 'app-nfc-geo')
                       && (request.resource.data.tipo == 'in' || request.resource.data.tipo == 'out')
                       && request.resource.data.filialeId is string
                       && request.resource.data.giorno is string
                       && request.resource.data.giorno.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                       && request.resource.data.mese is string
                       && request.resource.data.mese.matches('[0-9]{4}-[0-9]{2}')
                       && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT DENY — qualsiasi altra collezione resta chiusa
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
