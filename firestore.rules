rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// AVR LOGISTIC DASHBOARD — Firestore Security Rules
// Project: avr-logistic-dashboard
//
// Modello di autorizzazione:
//   • superadmin → amministrazione@avrlogisticarl.com (accesso completo)
//   • staff      → michela@, alessandra@ (accesso completo operativo,
//                  no costi mensili, no log accessi)
//   • driver     → qualsiasi altro utente autenticato (app driver):
//                  accede solo ai propri record (filtrati su driverEmail)
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email != null
             ? request.auth.token.email.lower()
             : '';
    }

    function isSuperAdmin() {
      // Doppia allowlist durante il rebrand Last Mile: la mail AVR va
      // rimossa allo spegnimento del dominio avrlogisticarl.com.
      return isSignedIn()
             && (userEmail() == 'amministrazione@avrlogisticarl.com'
                 || userEmail() == 'guido@last-mile.it');
    }

    function isStaff() {
      return isSignedIn()
             && (userEmail() == 'michela@avrlogisticarl.com'
                 || userEmail() == 'alessandra@avrlogisticarl.com');
    }

    function isAdminOrStaff() {
      return isSuperAdmin() || isStaff();
    }

    function isDriver() {
      return isSignedIn() && !isAdminOrStaff();
    }

    // Nota: confronto case-sensitive. I client scrivono driverEmail
    // sempre in lowercase (vedi commit 8f702a6). Rimuovere .lower() sul
    // lato resource.data è necessario perché Firestore rifiuta le query
    // list se il filtro non combacia staticamente con la rule.
    function isOwnByEmail() {
      return resource.data.driverEmail is string
             && resource.data.driverEmail == userEmail();
    }

    // ═══════════════════════════════════════════════════════════
    // OPERATIVITÀ AVR — admin + staff R/W
    // ═══════════════════════════════════════════════════════════
    match /consegne/{doc} {
      allow read: if isGestionale();
      allow write: if isAdminOrStaff();
    }

    match /filiali/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdminOrStaff();
    }

    // ═══════════════════════════════════════════════════════════
    // DRIVER ANAGRAFICA — admin/staff full; driver legge solo proprio
    // ═══════════════════════════════════════════════════════════
    match /driverAnagrafica/{doc} {
      allow read: if isGestionale()
                     || (isDriver()
                         && resource.data.email is string
                         && resource.data.email == userEmail());
      allow create, delete: if canManageAnagrafica();
      allow update: if canManageAnagrafica()
                       || (isDriver()
                           && resource.data.email == userEmail()
                           && request.resource.data.email == resource.data.email
                           && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['codiceFiscale','telefono','dataNascita','indirizzo',
                                        'profiloCompletatoIl']));
      // numeroPatente/scadenzaPatente/patenteVerifica: SOLO la Cloud Function
      // verificaPatente (Admin SDK) dopo lettura AI delle foto — mai autodichiarati.
    }

    // ═══════════════════════════════════════════════════════════
    // REPORT DRIVER — admin/staff full; driver crea + legge/elimina suoi
    // ═══════════════════════════════════════════════════════════
    match /reportDriver/{doc} {
      allow read: if isGestionale() || (isDriver() && isOwnByEmail());
      // Validazioni anti-abuso: da questi dati dipendono classifica e premi.
      // numConsegne 1–10 (come il limite dell'app), durataMin plausibile se
      // presente (report vecchi non ce l'hanno), mese nel formato YYYY-MM.
      allow create: if isSignedIn()
                       && request.resource.data.driverEmail is string
                       && request.resource.data.driverEmail.lower() == userEmail()
                       && request.resource.data.numConsegne is int
                       && request.resource.data.numConsegne >= 1
                       && request.resource.data.numConsegne <= 10
                       && request.resource.data.mese is string
                       && request.resource.data.mese.matches('[0-9]{4}-[0-9]{2}')
                       && (!('durataMin' in request.resource.data)
                           || (request.resource.data.durataMin is number
                               && request.resource.data.durataMin > 0
                               && request.resource.data.durataMin <= 720));
      allow update: if isAdminOrStaff();
      allow delete: if isAdminOrStaff() || (isDriver() && isOwnByEmail());
    }

    // ═══════════════════════════════════════════════════════════
    // RITORNI — admin/staff full; driver crea + legge/elimina suoi
    // ═══════════════════════════════════════════════════════════
    match /ritorni/{doc} {
      allow read: if isGestionale() || (isDriver() && isOwnByEmail());
      allow create: if isSignedIn()
                       && request.resource.data.driverEmail is string
                       && request.resource.data.driverEmail.lower() == userEmail();
      // Conferma/rifiuto: ufficio, oppure il responsabile di zona (solo i
      // campi di esito; il filtro per provincia è applicato dal gestionale).
      allow update: if isAdminOrStaff() || isAmministratore() || isRisorseUmane()
                       || (isResponsabile()
                           && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['stato', 'gestito', 'gestitoDa', 'gestitoIl']));
      allow delete: if isAdminOrStaff() || (isDriver() && isOwnByEmail());
    }

    // ═══════════════════════════════════════════════════════════
    // SEGNALAZIONI — admin/staff full; driver crea + legge sue
    // ═══════════════════════════════════════════════════════════
    match /segnalazioni/{doc} {
      allow read: if isGestionale() || (isDriver() && isOwnByEmail());
      allow create: if isSignedIn()
                       && request.resource.data.driverEmail is string
                       && request.resource.data.driverEmail.lower() == userEmail();
      // Risoluzione: ufficio (amministratore/HR inclusi — prima erano esclusi
      // per errore) oppure responsabile di zona, solo i campi di esito.
      allow update: if isAdminOrStaff() || isAmministratore() || isRisorseUmane()
                       || (isResponsabile()
                           && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['stato', 'risoltaDa', 'risoltaIl']));
      allow delete: if isAdminOrStaff();
    }

    // ═══════════════════════════════════════════════════════════
    // TURNI DRIVER — driver crea all'ingresso; admin/staff legge
    // ═══════════════════════════════════════════════════════════
    match /turniDriver/{doc} {
      allow create: if isSignedIn()
                       && request.resource.data.email is string
                       && request.resource.data.email == userEmail();
      allow read: if isAdminOrStaff()
                     || (isDriver()
                         && resource.data.email is string
                         && resource.data.email == userEmail());
      // Chiusura turno dall'app driver: solo il proprio doc, solo i campi
      // di chiusura (targa/data/oraInizio restano immutabili).
      allow update: if isSuperAdmin()
                       || (isDriver()
                           && resource.data.email is string
                           && resource.data.email == userEmail()
                           && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['oraFine', 'durataTurnoMin', 'kmFine', 'chiusoIl']));
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // PRESENZE DRIVER — presenzeDriver/{email}_{YYYY-MM-DD}, un doc per
    // driver e giorno. I campi app (fonti, presenteApp, primoAccesso) li
    // scrivono solo le CF presenzaDaTurno/presenzaDaRapporto (admin SDK).
    // Dal gestionale si scrivono solo causale e nota: HR/amministratore
    // ovunque e anche a mese chiuso; responsabile solo nelle sue province
    // e a mese aperto. Il driver legge solo i propri giorni.
    // ═══════════════════════════════════════════════════════════
    function provinceResponsabile() {
      return get(/databases/$(database)/documents/utenti/$(userEmail())).data.province;
    }
    function canGestirePresenze() {
      return isSuperAdmin() || isAmministratore() || isRisorseUmane();
    }
    function mesePresenzeChiuso(mese) {
      return exists(/databases/$(database)/documents/presenzeMesi/$(mese))
             && get(/databases/$(database)/documents/presenzeMesi/$(mese)).data.chiuso == true;
    }
    function puoScriverePresenza(d) {
      return canGestirePresenze()
             || (isResponsabile()
                 && d.citta in provinceResponsabile()
                 && !mesePresenzeChiuso(d.mese));
    }
    function causaleValida(d) {
      return !('causale' in d)
             || d.causale == null
             || d.causale in ['presente', 'ferie', 'malattia', 'permesso', 'riposo', 'assente', 'non_lavorato'];
    }
    match /presenzeDriver/{id} {
      allow read: if isAdminOrStaff() || canGestirePresenze()
                     || (isResponsabile() && resource.data.citta in provinceResponsabile())
                     || (isDriver() && resource.data.email == userEmail());
      // Giorno senza attività in app (ferie, malattia, presenza confermata a mano)
      allow create: if puoScriverePresenza(request.resource.data)
                       && id == request.resource.data.email + '_' + request.resource.data.data
                       && request.resource.data.mese == request.resource.data.data[0:7]
                       && request.resource.data.keys().hasOnly(['email', 'data', 'mese', 'driver', 'driverNome', 'citta', 'causale', 'nota', 'modificatoDa', 'modificatoIl'])
                       && request.resource.data.modificatoDa == userEmail()
                       && causaleValida(request.resource.data);
      // richiestaId: il gestionale lo toglie quando sovrascrive un giorno nato da una richiesta d'assenza
      allow update: if puoScriverePresenza(resource.data)
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['causale', 'nota', 'modificatoDa', 'modificatoIl', 'richiestaId'])
                       && !('richiestaId' in request.resource.data)
                       && request.resource.data.modificatoDa == userEmail()
                       && causaleValida(request.resource.data);
      allow delete: if isSuperAdmin();
    }
    // Chiusura mese presenze: dopo la chiusura i responsabili non modificano più
    match /presenzeMesi/{mese} {
      allow read: if isGestionale();
      allow write: if canGestirePresenze();
    }

    // ═══════════════════════════════════════════════════════════
    // RICHIESTE ASSENZA — ferie, permessi, malattia dall'app driver.
    // Il driver crea solo per sé (ferie/permesso in_attesa, malattia
    // registrata con il solo numero di protocollo) e può annullarle.
    // Decide il responsabile della provincia o HR/amministratore; HR
    // può anche revocare dopo. Nome e provincia li riscrive la CF
    // richiestaAssenzaCreata dall'anagrafica; le causali in
    // presenzeDriver le scrivono le CF.
    // ═══════════════════════════════════════════════════════════
    function decideRichiesta() {
      return canGestirePresenze()
             || (isResponsabile() && resource.data.citta in provinceResponsabile());
    }
    match /richiesteAssenza/{id} {
      allow read: if isAdminOrStaff() || canGestirePresenze()
                     || (isResponsabile() && resource.data.citta in provinceResponsabile())
                     || (isSignedIn() && resource.data.email == userEmail());
      allow create: if isSignedIn()
                       && request.resource.data.email == userEmail()
                       && request.resource.data.keys().hasOnly(['email', 'driver', 'driverNome', 'citta', 'tipo', 'dal', 'al', 'protocollo', 'nota', 'stato', 'creataIl'])
                       && request.resource.data.tipo in ['ferie', 'permesso', 'malattia']
                       && request.resource.data.stato == (request.resource.data.tipo == 'malattia' ? 'registrata' : 'in_attesa')
                       && request.resource.data.dal is string && request.resource.data.dal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                       && request.resource.data.al is string && request.resource.data.al.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                       && request.resource.data.al >= request.resource.data.dal
                       // nota breve (niente diagnosi), protocollo = solo il numero del certificato
                       && (!('nota' in request.resource.data) || (request.resource.data.nota is string && request.resource.data.nota.size() <= 80))
                       && (!('protocollo' in request.resource.data) || (request.resource.data.protocollo is string && request.resource.data.protocollo.size() <= 20));
      allow update: if
                       // Driver: annulla la propria richiesta non ancora decisa (o la malattia comunicata)
                       (resource.data.email == userEmail()
                        && resource.data.stato in ['in_attesa', 'registrata']
                        && request.resource.data.stato == 'annullata'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'annullataIl']))
                       // Responsabile di provincia o HR: approva o rifiuta
                       || (decideRichiesta()
                           && resource.data.stato == 'in_attesa'
                           && request.resource.data.stato in ['approvata', 'rifiutata']
                           && request.resource.data.decisaDa == userEmail()
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'decisaDa', 'decisaIl', 'motivoRifiuto']))
                       // HR/amministratore: revoca anche dopo la decisione
                       || (canGestirePresenze()
                           && request.resource.data.stato in ['approvata', 'rifiutata', 'annullata']
                           && request.resource.data.decisaDa == userEmail()
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'decisaDa', 'decisaIl', 'motivoRifiuto']));
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // PUSH SUBSCRIPTIONS — l'app driver registra il proprio device;
    // legge/invia solo la Cloud Function (admin SDK bypassa le rules)
    // ═══════════════════════════════════════════════════════════
    match /pushSubscriptions/{doc} {
      allow create: if isSignedIn()
                       && request.resource.data.email is string
                       && request.resource.data.email == userEmail();
      allow read, update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // DANNI — admin/staff/amministratore/HR full; driver legge solo suoi
    // (HR registra multe/addebiti verbali e rateizzazioni)
    // ═══════════════════════════════════════════════════════════
    // Danni/multe: superadmin, amministratore, risorse umane in lettura/scrittura;
    // responsabili di zona in sola lettura (dal 05/10/2026, il gestionale mostra
    // solo i driver delle loro province); staff esclusi; driver i propri.
    match /danni/{doc} {
      allow read: if isSuperAdmin() || isAmministratore() || isRisorseUmane() || isResponsabile() || (isDriver() && isOwnByEmail());
      allow write: if isAdminOrStaff() || isAmministratore() || isRisorseUmane();
    }

    // ═══════════════════════════════════════════════════════════
    // COSTI MENSILI — solo superadmin (dati sensibili)
    // ═══════════════════════════════════════════════════════════
    match /costiMensili/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // LOG ACCESSI — tutti scrivono (auto-log), solo superadmin legge
    // ═══════════════════════════════════════════════════════════
    match /accessLog/{doc} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /driverAccessLog/{doc} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // LEADERBOARD — aggregato precalcolato da Cloud Function scheduled
    // Versione anonima letta da tutti i driver autenticati.
    // Scritture solo da admin SDK (CF bypassa le rules).
    // ═══════════════════════════════════════════════════════════
    match /leaderboard/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Versione completa con nome reale del driver — tutto il gestionale
    // (i responsabili la vedono filtrata per provincia lato client).
    match /leaderboardFull/{doc} {
      allow read: if isGestionale();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // CONFIG APP — feature flag remoti (es. timbratureAttive):
    // letti da tutte le app, scritti solo dal superadmin.
    // ═══════════════════════════════════════════════════════════
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // UTENTI — anagrafica utenti gestionale (amministratori, HR,
    // responsabili). Solo il superadmin hardcoded può scrivere qui.
    // Ogni utente può leggere il PROPRIO doc (per risolvere ruolo lato client).
    // Le altre rules potranno leggere utenti/{email}.mansione per gate futuri.
    // ═══════════════════════════════════════════════════════════
    match /utenti/{email} {
      allow read: if isSuperAdmin()
                     || (isSignedIn() && email == userEmail());
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // PUNTI TIMBRATURA — 5 sedi provinciali (CT/SR/ME/PA/EN) con NFC.
    // Lettura consentita a tutti gli utenti autenticati: il driver deve
    // sapere lat/lng del proprio punto per validare pre-timbratura.
    // Scrittura solo admin/HR: superadmin, amministratore, risorse_umane.
    // ═══════════════════════════════════════════════════════════
    function isAmministratore() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/utenti/$(userEmail()))
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.mansione == 'amministratore'
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.attivo != false;
    }
    function isRisorseUmane() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/utenti/$(userEmail()))
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.mansione == 'risorse_umane'
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.attivo != false;
    }
    function canManageTimbrature() {
      return isSuperAdmin() || isAmministratore() || isRisorseUmane();
    }
    // Gestione anagrafica driver: admin/staff + amministratore + HR.
    // (I responsabili leggono soltanto, via isGestionale.)
    function canManageAnagrafica() {
      return isAdminOrStaff() || isAmministratore() || isRisorseUmane();
    }
    function isResponsabile() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/utenti/$(userEmail()))
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.mansione == 'responsabile'
             && get(/databases/$(database)/documents/utenti/$(userEmail())).data.attivo != false;
    }
    // Tutti gli utenti del gestionale (superadmin/staff hardcoded +
    // amministratori, HR e responsabili dalla collection utenti):
    // vedono produttività, danni, ritorni, segnalazioni, consegne.
    function isGestionale() {
      return isAdminOrStaff() || isAmministratore() || isRisorseUmane() || isResponsabile();
    }

    // ── FATTURE ELETTRONICHE (Fatture in Cloud) — scritte solo dalle CF fic*
    // Lettura: superadmin + amministratore (stato/anteprima in dashboard).
    match /fattureFic/{mese} {
      allow read: if isSuperAdmin() || isAmministratore();
      allow write: if false;
    }

    // ── FATTURE FIC PER MESE DI COMPETENZA (Report Finanziario) — scritte
    // solo dalla CF ficSyncFatture/ficSyncNotturno. Override manuali
    // (competenza, azienda, voce, escludi) e default per fornitore: direzione.
    match /fattureMese/{mese} {
      allow read: if isSuperAdmin() || isAmministratore();
      allow write: if false;
    }
    match /fattureOverride/{doc} {
      allow read, write: if isSuperAdmin() || isAmministratore();
    }
    match /fornitori/{doc} {
      allow read, write: if isSuperAdmin() || isAmministratore();
    }
    // Buste paga lette da Claude (CF elaboraBustePaga scrive); la direzione
    // le vede e può cancellare un cedolino caricato per errore.
    match /bustePaga/{doc} {
      allow read, delete: if isSuperAdmin() || isAmministratore();
      allow create, update: if false;
    }

    // ── ARCHIVIO DRIVER CESSATI — scritto solo dalla CF pulisciAnagrafica
    // (admin SDK). L'ufficio lo legge per l'attribuzione storica delle
    // consegne (cognomi/alias dei cessati restano riconosciuti).
    match /driverArchivio/{doc} {
      allow read: if isGestionale();
      allow write: if false;
    }

    match /puntiTimbratura/{provincia} {
      allow read: if isSignedIn();
      allow write: if canManageTimbrature();
    }

    // Token QR in chiaro per la stampa — SOLO gestori timbrature.
    // Nei doc puntiTimbratura è salvato solo l'hash SHA-256: i driver
    // verificano il QR scansionato senza poter leggere il token dal DB.
    match /qrTokens/{provincia} {
      allow read, write: if canManageTimbrature();
    }

    // ═══════════════════════════════════════════════════════════
    // TIMBRATURE — schema unificato per terminali ZKTeco (bridge,
    // admin SDK bypassa le rules) e app QR+geofence (create driver).
    // Nessuna modifica/cancellazione dal client: audit trail.
    // ═══════════════════════════════════════════════════════════
    match /timbrature/{doc} {
      // I driver NON leggono le timbrature (nemmeno le proprie): il dato
      // è visibile solo al team ufficio in dashboard. L'app driver tiene
      // solo un flag locale sul device per gate e verso automatico.
      allow read: if isAdminOrStaff()
                     || canManageTimbrature();
      allow create: if isSignedIn()
                       && request.resource.data.driverId is string
                       && request.resource.data.driverId == userEmail()
                       && request.resource.data.fonte == 'app'
                       && (request.resource.data.metodo == 'app-qr-geo' || request.resource.data.metodo == 'app-nfc-geo')
                       && (request.resource.data.tipo == 'in' || request.resource.data.tipo == 'out')
                       && request.resource.data.filialeId is string
                       && request.resource.data.giorno is string
                       && request.resource.data.giorno.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                       && request.resource.data.mese is string
                       && request.resource.data.mese.matches('[0-9]{4}-[0-9]{2}')
                       && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT DENY — qualsiasi altra collezione resta chiusa
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
