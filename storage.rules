rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Documenti danni/multe: SOLO Guido e Risorse Umane (decisione 22/09/2026)
    function isUfficioDanni() {
      return request.auth != null
             && request.auth.token.email != null
             && request.auth.token.email.lower() in ['guido@last-mile.it', 'risorse.umane@last-mile.it'];
    }
    match /danni/{allPaths=**} {
      allow read, write: if isUfficioDanni();
    }
    // Buste paga (PDF): solo direzione; un PDF può contenere tutti i cedolini
    // del mese (il consulente manda un file unico) → fino a 50 MB
    match /bustePaga/{mese}/{file} {
      allow read, delete: if isUfficioDanni();
      allow write: if isUfficioDanni()
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
    // Foto patente: ogni driver scrive SOLO nella propria cartella (uid),
    // immagini < 6 MB. Lettura: il driver stesso o un utente del gestionale
    // (doc utenti/{email} presente).
    match /patenti/{uid}/{file} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || firestore.exists(/databases/(default)/documents/utenti/$(request.auth.token.email)));
    }
  }
}
