rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Documenti danni/multe caricati dal gestionale
    match /danni/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Foto patente: ogni driver scrive SOLO nella propria cartella (uid),
    // immagini < 6 MB. Lettura: il driver stesso o un utente del gestionale
    // (doc utenti/{email} presente).
    match /patenti/{uid}/{file} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || firestore.exists(/databases/(default)/documents/utenti/$(request.auth.token.email)));
    }
  }
}
